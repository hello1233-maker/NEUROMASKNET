def set_seed(seed=42):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)




class AvgMeter:
    def __init__(self, name="Metric"):
        self.name = name
        self.reset()
    def reset(self):
        self.avg, self.sum, self.count = [0] * 3
    def update(self, val, count=1):
        self.count += count
        self.sum += val * count
        self.avg = self.sum / self.count
    def __repr__(self):
        return f"{self.name}: {self.avg:.4f}"

def get_lr(optimizer):
    for param_group in optimizer.param_groups:
        return param_group["lr"]




class DTU_AAD_Dataset(Dataset):
    def __init__(self, root, subject_ids, all_subject_ids_map):
        self.root = root
        self.data_cache = {}
        self.index_map = []
        self.domain_label_map = all_subject_ids_map
        
        for s_id in subject_ids:

            file_path = os.path.join(root, f"S{s_id}_Dataset_1s.npz")
            if not os.path.exists(file_path):
                warnings.warn(f"Warning: Data file not found for subject {s_id}: {file_path}")
                continue

            data = np.load(file_path, allow_pickle=True)
            eeg_data = torch.tensor(data['eeg_slices'], dtype=torch.float32)
            

            eeg_min = torch.min(eeg_data, dim=-1, keepdim=True)[0]
            eeg_max = torch.max(eeg_data, dim=-1, keepdim=True)[0]
            eeg_normalized = (eeg_data - eeg_min) / (eeg_max - eeg_min + 1e-8)
            
            self.data_cache[str(s_id)] = {
                'eeg': eeg_normalized,

                'direction_label': torch.tensor([int(item[0]) for item in data['event_slices']], dtype=torch.long) - 1
            }
            
            for i in range(len(eeg_normalized)):
                self.index_map.append({'subject_id': str(s_id), 'sample_idx': i})
        
        if not self.index_map:
            raise RuntimeError(f"Dataset is empty (Subjects: {subject_ids}). Please check path.")

    def __len__(self):
        return len(self.index_map)

    def __getitem__(self, idx):
        map_entry = self.index_map[idx]
        s_id, sample_idx = map_entry['subject_id'], map_entry['sample_idx']
        
        subject_data = self.data_cache[s_id]
        eeg = subject_data['eeg'][sample_idx]
        direction_label = subject_data['direction_label'][sample_idx]
        domain_label = self.domain_label_map.get(s_id, -1)

        return eeg, direction_label, torch.tensor(domain_label, dtype=torch.long)




