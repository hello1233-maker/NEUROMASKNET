def main():
    try:
        set_seed(42)
        config = TrainingConfig()
        main_results_dir = f"{config.save_dir}_{config.timestamp}"
        os.makedirs(main_results_dir, exist_ok=True)
        
        print("="*80)
        print(f"Task: LOSO-CV - Disentangled DANN-DBformer with paper-aligned NSAF on {config.dataset_name}")
        print(f"Results Path: {main_results_dir}")
        print("="*80)
        


        all_subject_ids = [str(i) for i in range(1, 19)] 
        all_folds_results = []

        for i, test_subject_id in enumerate(all_subject_ids):
            fold_num = i + 1
            print(f"\n{'='*30} FOLD {fold_num}/{len(all_subject_ids)} (Test Subject: {test_subject_id}) {'='*30}")
            
            fold_save_dir = os.path.join(main_results_dir, f"fold_{fold_num}_test_sub{test_subject_id}")
            os.makedirs(fold_save_dir, exist_ok=True)
            
            train_ids = [sid for sid in all_subject_ids if sid != test_subject_id]
            domain_map = {s_id: idx for idx, s_id in enumerate(train_ids)}
            
            print("Creating DataLoaders...")
            train_dataset = DTU_AAD_Dataset(config.data_root, train_ids, domain_map)
            train_loader = DataLoader(train_dataset, config.batch_size, shuffle=True, num_workers=config.num_workers, pin_memory=True)
            
            test_dataset = DTU_AAD_Dataset(config.data_root, [test_subject_id], domain_map)
            test_loader = DataLoader(test_dataset, config.batch_size, shuffle=False, num_workers=config.num_workers, pin_memory=True)
            
            print(f"Train: {len(train_dataset)}, Test: {len(test_dataset)}")
            
            best_acc_for_fold = run_training_session_dann(train_loader, test_loader, config, len(train_ids), fold_save_dir)
            all_folds_results.append({"fold": fold_num, "test_subject": test_subject_id, "best_accuracy": best_acc_for_fold})
            

            model = Disentangled_NeuroMask(
                chn=config.channel_size, time_sample_num=config.time_sample_num,
                patch_size=config.patch_size, spa_dim=config.spa_dim,
                num_direction_classes=2, num_domain_classes=len(train_ids),
                emb_size=config.emb_size, depth=config.depth, num_heads=config.num_heads,
                use_neuromask=True
            ).to(config.device)
            model.load_state_dict(torch.load(os.path.join(fold_save_dir, "best_model.pt"), map_location=config.device)['model_state_dict'])
            

        print("\n" + "="*80)
        print("All Folds Completed!")
        results_df = pd.DataFrame(all_folds_results)
        mean_accuracy, std_accuracy = results_df['best_accuracy'].mean(), results_df['best_accuracy'].std()

        print(results_df.to_string(index=False))
        print(f"\nAverage Accuracy: {mean_accuracy:.4f} ± {std_accuracy:.4f}")

        summary_data = {
            "mean_accuracy": mean_accuracy, "std_dev_accuracy": std_accuracy,
            "config": vars(config), "results": all_folds_results
        }
        with open(os.path.join(main_results_dir, "summary.json"), 'w') as f:
            json.dump(summary_data, f, indent=4)
        results_df.to_csv(os.path.join(main_results_dir, "summary.csv"), index=False)
        print(f"Results saved to: {main_results_dir}")
        
    except Exception as e:
        print(f"\n❌ Error: {e}")
        import traceback
        traceback.print_exc()

if __name__ == "__main__":
    main()
